<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="Character_Remover.CharacterRemover">
  <grid id="27dc6" binding="pnlCharacterRemoverMain" layout-manager="GridLayoutManager" row-count="4" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="20" left="50" bottom="20" right="50"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="43911" class="javax.swing.JLabel" binding="lblText">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"/>
        </properties>
      </component>
      <component id="e1907" class="javax.swing.JCheckBox" binding="cbVowels">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Vowels"/>
        </properties>
      </component>
      <component id="2ad0e" class="javax.swing.JCheckBox" binding="cbConsonants">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Consonants"/>
        </properties>
      </component>
      <component id="385f4" class="javax.swing.JCheckBox" binding="cbNumbers">
        <constraints>
          <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Numbers"/>
        </properties>
      </component>
      <component id="81648" class="javax.swing.JButton" binding="btnRemove">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Remove"/>
        </properties>
      </component>
      <component id="dd242" class="javax.swing.JButton" binding="btnRestore">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Restore"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
