<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="Number_Counter.NumberCounter">
  <grid id="27dc6" binding="pnlNumberCounter" layout-manager="GridLayoutManager" row-count="2" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="800" height="500"/>
    </constraints>
    <properties>
      <alignmentX value="1.0"/>
      <alignmentY value="1.0"/>
      <minimumSize width="500" height="500"/>
      <preferredSize width="500" height="500"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="37bfd" class="javax.swing.JButton" binding="decreaseButton">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Decrease"/>
        </properties>
      </component>
      <component id="1d8cc" class="javax.swing.JButton" binding="increaseButton">
        <constraints>
          <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Increase"/>
        </properties>
      </component>
      <component id="9b0ea" class="javax.swing.JLabel" binding="countLabel">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <alignmentX value="0.0"/>
          <text value="0"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
